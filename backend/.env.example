# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server
PORT=5000

# MongoDB Atlas connection string (includes your own username/password)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tax_admin_system?retryWrites=true&w=majority

# Admin login (auto-provisioned on first run if it doesn't exist yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Used to sign admin login tokens - use a long random string
JWT_SECRET=replace_with_a_long_random_secret

# Must match the URL the frontend is served from (for CORS)
CLIENT_URL=http://localhost:5173

# Optional - MongoDB connection tuning (defaults shown are used if omitted)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000
